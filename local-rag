#!/usr/bin/env bash
# Start/stop the local-rag-mcp assistant and its underlying Ollama model.
#
# Usage:
#   ./local-rag start   - ensure venv/model/index are ready, start Ollama if
#                          it isn't already running, then launch the
#                          interactive assistant (python main.py).
#   ./local-rag stop    - stop Ollama, but ONLY if this script started it.
#                          An Ollama instance that was already running
#                          before "start" is left untouched.
#
# The assistant itself (main.py) is a foreground interactive CLI - it stops
# on its own when you type exit/quit or press Ctrl+C. "stop" here is about
# the underlying model service, which otherwise keeps running in the
# background after you exit the CLI.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_DIR="$REPO_ROOT/.local-rag"
OLLAMA_PID_FILE="$STATE_DIR/ollama.pid"
OLLAMA_LOG_FILE="$STATE_DIR/ollama.log"
VENV_DIR="$REPO_ROOT/venv"
OLLAMA_URL="http://localhost:11434"

mkdir -p "$STATE_DIR"

get_ollama_model() {
    "$VENV_DIR/bin/python" -c "import sys; sys.path.insert(0, '$REPO_ROOT/src'); from config import OLLAMA_MODEL; print(OLLAMA_MODEL)"
}

ollama_is_up() {
    curl -s -o /dev/null -m 2 "$OLLAMA_URL/api/tags"
}

ensure_venv() {
    if [ ! -x "$VENV_DIR/bin/python" ]; then
        echo "==> Creating virtualenv at $VENV_DIR"
        python3 -m venv "$VENV_DIR"
        "$VENV_DIR/bin/pip" install -q --upgrade pip
        echo "==> Installing dependencies (first run only, may take a while)"
        "$VENV_DIR/bin/pip" install -q -r "$REPO_ROOT/src/requirements.txt"
    fi
}

ensure_ollama_running() {
    if ollama_is_up; then
        echo "==> Ollama already running - leaving it as-is (not managed by this script)"
        return
    fi

    if ! command -v ollama >/dev/null 2>&1; then
        echo "ERROR: ollama is not installed. Install it first: https://ollama.ai" >&2
        exit 1
    fi

    echo "==> Starting ollama serve in the background"
    nohup ollama serve >"$OLLAMA_LOG_FILE" 2>&1 &
    echo $! > "$OLLAMA_PID_FILE"

    for _ in $(seq 1 30); do
        if ollama_is_up; then
            echo "==> Ollama is up (pid $(cat "$OLLAMA_PID_FILE"))"
            return
        fi
        sleep 1
    done

    echo "ERROR: ollama serve did not become healthy in time. Check $OLLAMA_LOG_FILE" >&2
    exit 1
}

ensure_model_pulled() {
    local model
    model="$(get_ollama_model)"
    if ! ollama list | awk '{print $1}' | grep -qx "$model"; then
        echo "==> Pulling model $model (configured in src/config.py)"
        ollama pull "$model"
    fi
}

ensure_index_built() {
    if [ -f "$REPO_ROOT/src/index.faiss" ] && [ -f "$REPO_ROOT/src/chunks.pkl" ] && [ -f "$REPO_ROOT/src/fts.db" ]; then
        return
    fi

    if [ -z "$(find "$REPO_ROOT/src/docs" -maxdepth 1 -type f 2>/dev/null)" ]; then
        echo "==> No index found and src/docs/ is empty - skipping build-index (add documents first)"
        return
    fi

    echo "==> Building index from src/docs/"
    (cd "$REPO_ROOT/src" && "$VENV_DIR/bin/python" main.py build-index)
}

cmd_start() {
    ensure_venv
    ensure_ollama_running
    ensure_model_pulled
    ensure_index_built

    echo "==> Launching assistant (type 'exit', 'quit', or Ctrl+C to stop the app)"
    cd "$REPO_ROOT/src"
    exec "$VENV_DIR/bin/python" main.py
}

cmd_stop() {
    if [ ! -f "$OLLAMA_PID_FILE" ]; then
        echo "==> Ollama was not started by this script (or was already running) - leaving it running."
        echo "    To stop it manually: pkill -f 'ollama serve'"
        return
    fi

    local pid
    pid="$(cat "$OLLAMA_PID_FILE")"

    if ps -p "$pid" -o command= 2>/dev/null | grep -q "ollama"; then
        echo "==> Stopping Ollama (pid $pid)"
        kill "$pid"
    else
        echo "==> Recorded Ollama pid $pid is no longer running"
    fi

    rm -f "$OLLAMA_PID_FILE"
}

case "${1:-}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    *)
        echo "Usage: $0 {start|stop}" >&2
        exit 1
        ;;
esac
